# ──────────────────────────────────────────────
# ShadowLith — Backend Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Gemini API Keys ──────────────────────────
# At least one key is required. Up to 10 keys
# can be provided for rotation / rate-limit
# balancing. Leave unused slots commented out.
GEMINI_API_KEY_1=your_gemini_api_key_here
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# ...up to GEMINI_API_KEY_10

# ── Debug Settings ───────────────────────────
# Set to "true" to enable debug mode (uses the
# Vite dev server URL instead of bundled UI).
SHADOWLITH_DEBUG=false

# URL of the Vite dev server (only used when
# SHADOWLITH_DEBUG=true).
SHADOWLITH_DEBUG_URL=http://127.0.0.1:5174
